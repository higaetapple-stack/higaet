# Deterministic install policy for CI (`npm ci`) and MilesWeb production.
#
# The historic zod ERESOLVE conflict (@tanstack/zod-adapter peers on zod ^3.23.8
# while this project uses zod ^4) is now resolved by a targeted
# `overrides["@tanstack/zod-adapter"].zod = "$zod"` in package.json, so
# legacy-peer-deps is no longer required.

# Reproducible, quiet CI installs.
fund=false
audit=false
